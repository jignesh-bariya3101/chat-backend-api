PORT=3000

DATABASE_URL=mysql://root:root@127.0.0.1:3306/create_new

# Save the Firebase json as secrets/firebase-service-account.json, then restart.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Optional fallback when the json file above is missing.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Local Firestore emulator only. Leave unset for a real Firebase project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=chat-local
